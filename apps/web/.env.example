# Copy to .env.local for development. Never commit real secrets.

# Postgres 16+ (local, Neon, RDS…). Run `npm run db:migrate` after changing it.
DATABASE_URL=postgres://localhost:5432/zelo_dev
# Public URL of this app (used in invite and reset links).
APP_URL=http://localhost:3200
# Marketing site (links to pricing, terms, privacy).
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Behind Vercel/Cloudflare/nginx: trust X-Forwarded-For for per-IP rate limits.
# TRUST_PROXY=1
# IP_LIMIT_PER_HOUR=20
# DB_POOL_MAX=10

# Email (Resend). Without a key, emails are recorded and shown at /dev/mailbox.
# RESEND_API_KEY=
# EMAIL_FROM=Zelo <invites@yourdomain.com>
# DEV_MAILBOX=1        # also allow the mailbox in production builds (local testing only)

# Google sign-in (OAuth client for http(s)://APP_URL/api/auth/google/callback).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# File uploads on local disk (swap storage.ts for S3/R2 when running several servers).
# UPLOAD_DIR=.data/uploads

# The shared "Acme Store" sample workspace (on by default).
# DEMO_ENABLED=1
